rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }

    function me() {
      return get(/databases/$(database)/documents/users/$(uid())).data;
    }
    function isAdmin()    { return isSignedIn() && me().role == 'admin'; }
    function isLibrarian(){ return isSignedIn() && me().role == 'librarian'; }
    function isStaff()    { return isAdmin() || isLibrarian(); }

    // ─── users ───
    match /users/{userId} {
      allow read: if isSignedIn() && (uid() == userId || isStaff());
      allow create: if isSignedIn() && uid() == userId;
      allow update: if isAdmin() ||
        (isSignedIn() && uid() == userId &&
         !request.resource.data.diff(resource.data)
            .affectedKeys().hasAny(['role', 'status', 'borrowLimit', 'active']));
      allow delete: if isAdmin();
    }

    // ─── books ───
    match /books/{bookId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isStaff();
    }

    // ─── categories ───
    match /categories/{catId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isStaff();
    }

    // ─── borrowings ───
    match /borrowings/{borrowId} {
      allow read: if isSignedIn() &&
        (resource.data.userId == uid() || isStaff());

      allow create: if isSignedIn() &&
        request.resource.data.userId == uid();

      allow update: if isStaff() ||
        (resource.data.userId == uid() &&
         request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['status','notes']));

      allow delete: if isAdmin();
    }

    // ─── settings ───
    match /settings/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ─── category_images ───
    match /category_images/{catId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // ─── default deny ───
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
